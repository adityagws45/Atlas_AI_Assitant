# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database
DATABASE_URL=postgres://atlas:atlas@localhost:5433/atlas_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=
# Public bot username (no @) — deploy root redirects here: https://t.me/<username>
TELEGRAM_BOT_USERNAME=atlas_ai_financial_bot
# Local development: leave webhook empty and use `python manage.py run_bot` (polling).
# Production (Render Web Service + Neon): set HTTPS webhook, then run once:
#   python manage.py set_telegram_webhook
# Example (after you have the Render URL — do not invent it early):
# TELEGRAM_WEBHOOK_URL=https://YOUR-SERVICE.onrender.com/api/telegram/webhook/
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Deployment note (manual Render Web Service — not Blueprint-required)
# LOCAL:  DATABASE_URL → Docker Postgres localhost:5433
# PROD:   DATABASE_URL → Neon PostgreSQL (set in Render dashboard only)
# Do not commit real Neon credentials. Redis/Key Value is optional in production.
# ---------------------------------------------------------------------------

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3
GEMINI_TEMPERATURE=0.4
MAX_RECENT_MESSAGES=20

# Groq Whisper (speech-to-text only — Gemini remains the main AI)
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_WHISPER_TIMEOUT_SECONDS=60
MAX_VOICE_DURATION_SECONDS=120

# Finance
FINNHUB_API_KEY=
FINANCE_PRIMARY_PROVIDER=finnhub
FINANCE_FALLBACK_PROVIDER=yahoo

# Google OAuth (per Telegram user — never share one global token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development callback (must also be registered in Google Cloud Console):
GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/google/callback/
# Production (Render): BOTH of these must match Google Cloud → Credentials →
# Authorized redirect URIs exactly (trailing slash matters):
#   PUBLIC_BASE_URL=https://atlas-ai-assitant.onrender.com
#   GOOGLE_REDIRECT_URI=https://atlas-ai-assitant.onrender.com/api/oauth/google/callback/
# Leaving GOOGLE_REDIRECT_URI as localhost in production causes Error 400 redirect_uri_mismatch.
PUBLIC_BASE_URL=

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=

# Cache TTL (seconds)
CACHE_TTL_STOCK=300
CACHE_TTL_NEWS=600
CACHE_TTL_PROFILE=600
CACHE_TTL_SEC=600
CACHE_TTL_SHEET_VALUES=180
CACHE_TTL_SHEET_ANALYSIS=300
CACHE_TTL_GMAIL_META=120
CACHE_TTL_CALENDAR_EVENTS=120
