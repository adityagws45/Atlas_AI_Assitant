# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database
DATABASE_URL=postgres://atlas:atlas@localhost:5433/atlas_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=
# Local: leave webhook empty and use `python manage.py run_bot` (polling).
# Production ($0 Render web): set HTTPS webhook, then run:
#   python manage.py set_telegram_webhook
# Example:
# TELEGRAM_WEBHOOK_URL=https://your-service.onrender.com/api/telegram/webhook/
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3
GEMINI_TEMPERATURE=0.4
MAX_RECENT_MESSAGES=20

# Groq Whisper (speech-to-text only — Gemini remains the main AI)
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_WHISPER_TIMEOUT_SECONDS=60
MAX_VOICE_DURATION_SECONDS=120

# Finance
FINNHUB_API_KEY=
FINANCE_PRIMARY_PROVIDER=finnhub
FINANCE_FALLBACK_PROVIDER=yahoo

# Google OAuth (per Telegram user — never share one global token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development callback (must also be registered in Google Cloud Console):
GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/google/callback/
# Production: set the public HTTPS origin of the deployed Atlas backend.
# Google will redirect here after the user authorizes (same URI must be in Cloud Console).
# PUBLIC_BASE_URL=https://api.your-atlas-domain.com
# GOOGLE_REDIRECT_URI=https://api.your-atlas-domain.com/api/oauth/google/callback/
PUBLIC_BASE_URL=

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=

# Cache TTL (seconds)
CACHE_TTL_STOCK=300
CACHE_TTL_NEWS=600
CACHE_TTL_PROFILE=600
CACHE_TTL_SEC=600
CACHE_TTL_SHEET_VALUES=180
CACHE_TTL_SHEET_ANALYSIS=300
CACHE_TTL_GMAIL_META=120
CACHE_TTL_CALENDAR_EVENTS=120
